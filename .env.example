# פרטי האפליקציה מ-Google Cloud Console (Credentials -> OAuth client ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# כתובת ה-callback שהגדרתם ב-Google Cloud (חייבת להיות זהה בדיוק):
# https://<שם-האתר-שלכם>.netlify.app/.netlify/functions/oauth-callback
GOOGLE_REDIRECT_URI=

# מתקבל לאחר לחיצה על "התחברות לגוגל" באתר עצמו - ראו README
GMAIL_REFRESH_TOKEN=

# ה-ID של גיליון הגוגל "מעקב חשבוניות" (החלק בכתובת בין /d/ ל-/edit)
INVOICE_SHEET_ID=

# אופציונלי: ID של תיקיית דרייב קבועה שתשמש שורש. אם ריק - האפליקציה תיצור/תמצא
# לבד תיקייה בשם "חשבוניות" בדרייב שלכם.
DRIVE_ROOT_FOLDER_ID=

# אופציונלי: שאילתת חיפוש Gmail מותאמת אישית (תחביר חיפוש רגיל של Gmail).
# ברירת מחדל: subject:חשבונית newer_than:60d
GMAIL_SEARCH_QUERY=
